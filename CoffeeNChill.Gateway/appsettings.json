{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "FunctionsApi": {
    "BaseUrl": "http://localhost:7120/api/"
  },
  "Storage": {
    "ConnectionString": "UseDevelopmentStorage=true"
  },
  "Jwt": {
    "Issuer": "CoffeeNChill.Gateway",
    "Audience": "CoffeeNChill.Clients",
    "ExpiryMinutes": 60
  }
}
