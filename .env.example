# Copy this file to .env and fill it in. The real .env is in .gitignore - never commit it.
# Generate a key with:  openssl rand -base64 48   (Linux/VPS)
JWT_KEY=replace-with-a-random-string-of-at-least-32-characters

ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@coffeenchill.ac.za
ADMIN_PASSWORD=replace-with-a-strong-password

STAFF_USERNAME=barista
STAFF_EMAIL=barista@coffeenchill.ac.za
STAFF_PASSWORD=replace-with-a-strong-password

# Image selection used by docker-compose.yml
DOCKERHUB_USERNAME=modestsnake
IMAGE_TAG=latest
